<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feed routes | RSSerpent</title>
    <style>
        body {
            color: #202620;
            font-family: system-ui, sans-serif;
            line-height: 1.6;
            margin: 0;
        }
        main {
            max-width: 54rem;
            margin: 0 auto;
            padding: 2rem clamp(1rem, 4vw, 2.5rem);
        }
        a { color: #17643c; }
        h1, h2 { line-height: 1.25; }
        h2 { overflow-wrap: anywhere; }
        section {
            border-top: 1px solid #d6dfd6;
            margin-top: 2rem;
        }
        ul { padding-inline-start: 1.25rem; }
        li + li { margin-top: .2rem; }
        .feeds {
            list-style: none;
            padding: 0;
        }
        .feeds > li {
            background: #f4f7f4;
            border-radius: .4rem;
            margin-bottom: .75rem;
            padding: .75rem 1rem;
        }
        .feeds p { margin: .35rem 0 0; }
        .feeds h3, .feeds h4 { margin: .6rem 0 .2rem; }
        .feeds dl { margin: 0; }
        .feeds dd { margin-inline-start: 1rem; }
        .description { white-space: pre-line; }
        code { overflow-wrap: anywhere; }
    </style>
</head>
<body>
    <main>
        <nav aria-label="Main navigation"><a href="{{ url_for('index') }}">RSSerpent</a></nav>
        <h1>Feed routes</h1>
        {% if plugins %}
        <p>Replace placeholders in braces with values before using a subscription URL.</p>
        <p><a href="https://rsserpent-rev.github.io/RSSerpent/latest/usage/router/#request-limits">Feed filters and request limits</a></p>
        {% for plugin in plugins %}
        <section>
            <h2>{{ plugin.name }}</h2>
            <p><a href="{{ plugin.repository }}">Plugin repository</a> &middot; <a href="{{ plugin.author.link }}">{{ plugin.author.name }}</a></p>
            <ul class="feeds">
                {% for group in feed_routes[plugin.name] %}
                <li>
                    {% if group.summary %}<h3>{{ group.summary }}</h3>{% endif %}
                    {% if group.description %}<p class="description">{{ group.description }}</p>{% endif %}
                    <ul>
                        {% for route in group.routes %}
                        <li>
                            {% if group.path_parameters or group.query_parameters | selectattr('required') | first %}
                            <code>{{ route.path }}</code>
                            {% else %}
                            <a href="{{ request.base_url }}{{ route.path[1:] | urlencode }}"><code>{{ route.path }}</code></a>
                            {% endif %}
                        </li>
                        {% endfor %}
                    </ul>
                    {% if group.uses_format_query %}
                    <p>Returns RSS by default. Add <code>?format=atom</code> for Atom.</p>
                    {% endif %}
                    {% for heading, parameters in [('Path parameters', group.path_parameters), ('Query parameters', group.query_parameters)] %}
                    {% if parameters %}
                    <h4>{{ heading }}</h4>
                    <dl>
                        {% for parameter in parameters %}
                        <dt><code>{{ parameter.name }}</code> &middot; {{ 'required' if parameter.required else 'optional' }}{% if parameter.type_label %} &middot; {{ parameter.type_label }}{% endif %}</dt>
                        {% if parameter.description %}<dd>{{ parameter.description }}</dd>{% endif %}
                        {% endfor %}
                    </dl>
                    {% endif %}
                    {% endfor %}
                    {% if group.examples %}
                    <h4>Examples</h4>
                    <ul>
                        {% for example in group.examples %}
                        <li>{{ example.label }} &middot; <a href="{{ request.base_url }}{{ example.rss }}">RSS</a> &middot; <a href="{{ request.base_url }}{{ example.atom }}">Atom</a></li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endfor %}
        {% else %}
        <p>No feed routes are enabled on this instance.</p>
        {% endif %}
    </main>
</body>
</html>
